rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if the logged-in user matches the resource owner ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User document & subcollections (/users/{userId}/...)
    // Each user can read/write only their own document and subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Top-level documents indexed by userId (e.g., /appState/{userId}, /userState/{userId})
    match /{collection}/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 3. Top-level collection documents containing a 'uid' or 'userId' field matching current user
    match /{document=**} {
      allow read, write: if isAuthenticated() && (
        (resource != null && (resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid)) ||
        (request.resource != null && (request.resource.data.uid == request.auth.uid || request.resource.data.userId == request.auth.uid))
      );
    }

    // 4. Fallback security: Deny all unauthenticated or unmatched access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
